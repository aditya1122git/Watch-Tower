# Environment variables for Social Media Watchtower

# App Environment
ENV=development
DEBUG=True
SECRET_KEY=dev-insecure-secret-key-change-in-production-1234567890
DATABASE_URL=sqlite+aiosqlite:///./social_watchtower.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_watchtower

# Redis
REDIS_URL=redis://localhost:6379/0

# Privacy & DPDP Act 2023 Settings
HASH_SALT=bihar-watchtower-dpdp-salt-2026-secure-random
COMMENT_RETENTION_DAYS=90

# AI / Sentiment Classification
GEMINI_API_KEY=
LLM_PROVIDER=gemini # gemini | local_fallback
SENTIMENT_CONFIDENCE_THRESHOLD=0.75

# Platform API Keys (Official APIs & Scrapers)
YOUTUBE_API_KEY=
YOUTUBE_BACKUP_API_KEY=
APIFY_API_TOKEN=
TWITTER_BEARER_TOKEN=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Telegram Alert Settings (Multiple Chat IDs comma-separated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=7566579670, 7574720019

# Alert Webhook Settings
ALERT_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=

# Automated Platform Report Refresh Cycles (in minutes)
REFRESH_INTERVAL_FB_INSTA_MINUTES=80
REFRESH_INTERVAL_OTHER_MINUTES=10
